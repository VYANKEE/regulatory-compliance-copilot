# LLM providers (hybrid strategy -- see docs/README for why)
GOOGLE_API_KEY=
NVIDIA_API_KEY=

# Database (Phase 10). Local dev falls back to a sqlite file automatically
# if this is unset -- see backend/app/core/config.py.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/compliance_copilot

# Redis (Phase 10 -- rate limiting + caching)
REDIS_URL=redis://localhost:6379/0

# Firebase Auth (Phase 10) -- path to a service-account JSON file, not the
# project ID. Download from Firebase Console -> Project Settings -> Service
# Accounts -> Generate new private key.
FIREBASE_CREDENTIALS_PATH=

# Rate limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=20

# CORS (comma-separated origins allowed to call the API)
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000

# Observability (Phase 12)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
